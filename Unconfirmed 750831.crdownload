import { KEYS } from '../config/storage-keys.js';

export function read(key, fallback = []) {
  try {
    const raw = localStorage.getItem(key);
    if (raw === null) return fallback;
    const value = JSON.parse(raw);
    return value ?? fallback;
  } catch (error) {
    console.warn(`Kisan Mitra: unable to read ${key}; using a safe default.`, error);
    return fallback;
  }
}

export function write(key, value) {
  try {
    localStorage.setItem(key, JSON.stringify(value));
    return true;
  } catch (error) {
    console.error(`Kisan Mitra: unable to save ${key}.`, error);
    const quotaMessage = error?.name === 'QuotaExceededError'
      ? 'Browser storage is full. Remove large images or clear old demo records.'
      : 'This browser could not save the data. Check its storage permissions.';
    window.dispatchEvent(new CustomEvent('km:storage-error', { detail: quotaMessage }));
    return false;
  }
}

export const all = (collection) => read(KEYS[collection], []);
export const saveAll = (collection, rows) => write(KEYS[collection], rows);
export const uid = (prefix = 'KM') => `${prefix}-${Date.now().toString(36).toUpperCase()}-${Math.random().toString(36).slice(2, 7).toUpperCase()}`;

export function logActivity(message, type = 'general') {
  const entries = read(KEYS.activity, []);
  entries.unshift({ id: uid('ACT'), message, type, createdAt: new Date().toISOString() });
  write(KEYS.activity, entries.slice(0, 30));
}

export function currentUser() {
  const session = read(KEYS.session, null);
  if (!session?.userId) return null;
  return all('users').find((user) => user.id === session.userId) || null;
}

export function resetDemoData() {
  Object.values(KEYS).forEach((key) => localStorage.removeItem(key));
}
