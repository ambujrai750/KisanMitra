import { currentUser } from './storage.js';

export function requireUser(roles = []) {
  const user = currentUser();
  if (!user) {
    window.location.href = 'login.html';
    return null;
  }
  if (roles.length && !roles.includes(user.role)) {
    window.location.href = 'dashboard.html';
    return null;
  }
  return user;
}
